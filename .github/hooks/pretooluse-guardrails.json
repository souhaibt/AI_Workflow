{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block-dangerous-commands.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|createFile",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block-generated-file-edit.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
